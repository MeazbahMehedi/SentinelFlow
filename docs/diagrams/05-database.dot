digraph G {graph [bgcolor="white",pad="0.3",nodesep="0.38",ranksep="0.5",fontname="Arial"]; node [shape=box,style="rounded,filled",fillcolor="#eaf3ef",color="#7b988b",fontname="Arial",fontsize=12,margin="0.15,0.12"]; edge [color="#537565",arrowsize=0.75,fontname="Arial",fontsize=10]; rankdir=TB;node[shape=record,style=filled,fillcolor="#edf4f0",fontsize=11];sessions[label="{sessions|PK id\lname source status\ltotal processed speed\lcreated error dropped\lrule_snapshot\l}"];packets[label="{packets|PK id\lFK session_id\lts src dst sport dport\lproto length flags dns\l}"];alerts[label="{alerts|PK id\lFK session_id\lts rule severity src dst\ltitle evidence status note\l}"];replay[label="{replay_packets|PK session_id and seq\lFK session_id\levent JSON\l}"];users[label="{users|PK id\lUNIQUE username\lpassword hash email role\l}"];config[label="{config|PK key\lvalue JSON\l}"];profiles[label="{profiles|PK id\lname role bio skills\lemail github linkedin website\lphoto cv\l}"];audit[label="{audit|PK id\lts action detail\l}"];sessions->packets[label="1 to many",arrowhead=crow];sessions->alerts[label="1 to many",arrowhead=crow];sessions->replay[label="1 to many",arrowhead=crow];{rank=same;users;config;profiles;audit;}}